# Database and authentication
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# The deployed Render URL, for example https://shareplate.onrender.com
FRONTEND_URL=https://your-service.onrender.com

# Google Maps (server-side)
GOOGLE_MAPS_API_KEY=your-google-maps-server-key

# SendGrid email
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_EMAIL=verified-sender@example.com

# Cloudflare R2
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://your-public-r2-domain
