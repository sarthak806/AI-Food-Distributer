# Use the same Render service URL. Do not include a trailing slash.
VITE_Backend_URL=https://your-service.onrender.com

# Geoapify provides address autocomplete and reverse geocoding for the pickup map.
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key

# Optional analytics; loaded only after cookie consent.
VITE_GA4_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
