# Use the same Render service URL. Do not include a trailing slash.
VITE_Backend_URL=https://your-service.onrender.com

# Browser-safe Google Maps key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Optional analytics; loaded only after cookie consent.
VITE_GA4_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
